# Copie para sabor_da_terra/.env (essa pasta é onde o `adk web` procura o .env).
# Nunca faça commit do .env.

# Chave do Google AI Studio
GOOGLE_API_KEY=coloque-sua-chave-aqui

# Modelo do Gemini (troque aqui, sem mexer no código)
GEMINI_MODEL=gemini-3.1-flash-lite

# Data de referência da demo (os pedidos da Facepe chegaram entre 28 e 30/10/2026).
# Sem ela, o agente usa a data de hoje.
DATA_REFERENCIA=2026-10-30

# Não defina GOOGLE_GENAI_USE_ENTERPRISE no protótipo: só entra na versão Google Cloud.

# Só se o Postgres entrar (P4-4)
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/sabor_da_terra
